 "tools": [
  {
   "name": "get_sensor_snapshot",
   "title": "Sensor snapshot (cached MQTT state)",
   "description": "Return the sensor's receiver settings and the classifier's latest observation from a persistent MQTT subscription, with provenance and per-field freshness. 'retained' means only the broker's replayed copy was seen since this server connected, so the producer may be down; 'stale' means the last live message is older than the configured maximum age. The classifier section is taken from state/classifier/observation (atomic, with producer sequence, boot id, template hash and feature-semantics version); when a sensor only publishes the legacy result topic the section is marked best_effort with the missing fields set to null. Missing values are never defaulted.",
   "input_schema": {
    "properties": {},
    "type": "object",
    "title": "get_sensor_snapshotArguments"
   },
   "execution": null,
   "output_schema": {
    "properties": {
     "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
     }
    },
    "required": [
     "result"
    ],
    "type": "object",
    "title": "get_sensor_snapshotOutput"
   },
   "icons": null,
   "annotations": {
    "title": null,
    "read_only_hint": true,
    "destructive_hint": false,
    "idempotent_hint": true,
    "open_world_hint": false
   },
   "meta": null
  },
  {
   "name": "snapshot_fpga_waterfall",
   "title": "FPGA spectrum snapshot (/waterfall)",
   "description": "Collect up to max_frames binary frames from maia-httpd's /waterfall WebSocket within timeout_s (both bounded by the server configuration), verify they describe one spectrometer context (GET /api before and after, constant FFT size and step word), average them in the power domain and return the frequency grid, a decimated PSD summary, a declared noise-floor estimate, above-floor segments and provenance. Levels are dB relative to the producer's unit scale, not dBm. DDC input, non-ADC input and sweep mode are reported as unsupported rather than interpreted. Read-only.",
   "input_schema": {
    "properties": {
     "max_frames": {
      "default": 4,
      "title": "Max Frames",
      "type": "integer"
     },
     "timeout_s": {
      "default": 15.0,
      "title": "Timeout S",
      "type": "number"
     },
     "threshold_over_floor_db": {
      "default": 10.0,
      "title": "Threshold Over Floor Db",
      "type": "number"
     }
    },
    "type": "object",
    "title": "snapshot_fpga_waterfallArguments"
   },
   "execution": null,
   "output_schema": {
    "properties": {
     "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
     }
    },
    "required": [
     "result"
    ],
    "type": "object",
    "title": "snapshot_fpga_waterfallOutput"
   },
